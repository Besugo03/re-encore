# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Absolute path to your media library on the HOST.
# It is mounted at the same path inside the container, so paths stored in
# data/config.json (watched folders, processed dir) work unchanged.
# Examples:
#   MEDIA_DIR=/mnt/Disk1/Videos
#   MEDIA_DIR=/srv/media
MEDIA_DIR=/home/user/Videos

# Your host user's UID/GID: files written by the container will be owned by
# you instead of root. Find yours with: id -u / id -g
PUID=1000
PGID=1000
